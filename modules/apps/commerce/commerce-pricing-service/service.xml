<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.1.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_1_0.dtd">

<service-builder auto-namespace-tables="false" package-path="com.liferay.commerce.pricing">
	<author>Riccardo Alberti</author>
	<namespace>Commerce</namespace>
	<entity external-reference-code="true" local-service="true" name="CommercePricingClass" remote-service="true" uuid="true">

		<!-- PK fields -->

		<column name="commercePricingClassId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="groupId" type="long" />
		<column name="name" type="String" />
		<column name="title" type="String" />
		<column name="description" type="String" />
		<column name="lastPublishDate" type="Date" />

		<!-- Order -->

		<order by="desc">
			<order-column name="createDate" />
		</order>

		<!-- Finder methods -->

		<finder name="CompanyId" return-type="Collection">
			<finder-column name="companyId" />
		</finder>
		<finder name="GroupId" return-type="Collection">
			<finder-column name="groupId" />
		</finder>
	</entity>
	<entity local-service="true" name="CommercePricingClassRel" remote-service="true">

		<!-- PK fields -->

		<column name="commercePricingClassRelId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="commercePricingClassId" type="long" />
		<column name="classNameId" type="long" />
		<column name="classPK" type="long" />

		<!-- Order -->

		<order by="desc">
			<order-column name="createDate" />
		</order>

		<!-- Finder methods -->

		<finder name="CommercePricingClassId" return-type="Collection">
			<finder-column name="commercePricingClassId" />
		</finder>
		<finder name="CPC_CN" return-type="Collection">
			<finder-column name="commercePricingClassId" />
			<finder-column name="classNameId" />
		</finder>
		<finder name="CN_CPK" return-type="Collection">
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
		</finder>
	</entity>
	<exceptions>
		<exception>CommercePricingClassDisplayDate</exception>
		<exception>CommercePricingClassExpirationDate</exception>
		<exception>CommercePricingClassName</exception>
		<exception>CommercePricingClassTitle</exception>
	</exceptions>
</service-builder>