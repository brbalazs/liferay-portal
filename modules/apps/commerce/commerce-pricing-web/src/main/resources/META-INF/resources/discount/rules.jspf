 * SPDX-License-Identifier: LGPL-2.1-or-later OR LicenseRef-Liferay-DXP-EULA-2.0.0-2023-06
 */
--%>

<c:if test="<%= hasPermission %>">
	<div class="row">
		<div class="col-12">
			<commerce-ui:panel
				bodyClasses="p-0"
				title='<%= LanguageUtil.get(request, "rules") %>'
			>
				<aui:fieldset helpMessage="select-whether-rules-should-be-evaluated-in-and-or-or">
					<div class="align-items-center d-flex justify-content-end px-3">
						<div class="mr-3"><%= LanguageUtil.get(request, "rules-connector") %></div>
						<div class="mr-3">
							<aui:input checked="<%= commerceDiscount.isRulesConjunction() %>" label="And" name="rulesConjunction" type="radio" value="<%= true %>" />
						</div>

						<div>
							<aui:input checked="<%= !commerceDiscount.isRulesConjunction() %>" label="Or" name="rulesConjunction" type="radio" value="<%= false %>" />
						</div>
					</div>
				</aui:fieldset>

				<commerce-ui:headless-dataset-display
					apiUrl="<%= commerceDiscountDisplayContext.getDiscountRulesApiUrl() %>"
					clayCreationMenu="<%= commerceDiscountDisplayContext.getClayCreationDiscountRuleMenu() %>"
					clayHeadlessDataSetActionTemplates="<%= commerceDiscountDisplayContext.getClayHeadlessDataSetActionDiscountRulesTemplates() %>"
					formId="fm"
					id="<%= CommercePricingDataSetConstants.COMMERCE_DATA_SET_KEY_DISCOUNT_RULES %>"
					itemsPerPage="<%= 10 %>"
					namespace="<%= renderResponse.getNamespace() %>"
					pageNumber="<%= 1 %>"
					portletURL="<%= portletDiscountRuleURL %>"
				/>
			</commerce-ui:panel>
		</div>
	</div>
</c:if>