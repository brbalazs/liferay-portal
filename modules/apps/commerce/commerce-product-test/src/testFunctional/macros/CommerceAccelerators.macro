definition {

	@summary = "Default summary"
	macro initializeAccelerator(siteName = null) {
		CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = ${siteName});
	}

	@summary = "Default summary"
	macro initializeNewSiteViaAccelerator(siteName = null) {
		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addCP(
			membershipType = "Private",
			siteName = ${siteName},
			siteTemplateName = ${siteName});
	}

}