<html>
<head>
<title>CommerceAccelerators</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">CommerceAccelerators</td></tr>
</thead>
<tbody>
<tr>
	<td>ACCOUNT_MANAGEMENT_ADD_MODAL_PLUS_BUTTON</td>
	<td>//span[text()='${key_userEmailAddress}']//following::button[1]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_MANAGEMENT_MEMBER_ACTIONS_DROPDOWN</td>
	<td>//tr/td[contains(.,'${key_memberEmailAddress}')]/..//following-sibling::td//button</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SELECTOR_DROPDOWN</td>
	<td>//button[@data-onclick='toggleAccountSelector']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_TO_CART_BUTTON</td>
	<td>//a[contains(.,'${key_productName}')]//..//button[contains(@class,'add-to-cart')]</td>
	<td></td>
</tr>
<tr>
	<td>ANY_BUTTON</td>
	<td>//div/*[contains(@class,'commerce-button') and contains (.,'${key_button}')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMERCE_QUANTITY_SELECTOR_INPUT</td>
	<td>//a[contains(.,'${key_productName}')]//..//form[(@class='quantity-selector')]//input</td>
	<td></td>
</tr>
<tr>
	<td>MINI_CART_BUTTON</td>
	<td>//div[contains(@class,'mini-cart-wrapper')]/button</td>
	<td></td>
</tr>
<tr>
	<td>MINIUM_SIDEBAR_USER_AVATAR</td>
	<td>//div[contains(@class,'minium-user-nav__avatar')]</td>
	<td></td>
</tr>
<tr>
	<td>MINIUM_SIDEBAR_MENU_ITEM</td>
	<td>//div[@class='minium-sidebar']//..//a[contains (.,'${key_menuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLES_BUTTON</td>
	<td>//button[contains(.,'Roles')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLES_MODAL_ROLE_CHECKBOX</td>
	<td>//div/input[@type='checkbox' and @name='${key_role}']</td>
	<td></td>
</tr>
<tr>
	<td>SORT_BY_DROPDOWN</td>
	<td>//div/button[contains(.,'Sort By')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>