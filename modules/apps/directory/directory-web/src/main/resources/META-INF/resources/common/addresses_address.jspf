<%
ListType addressListType = address.getType();
%>

<em class="mailing-name"><%= LanguageUtil.get(request, addressListType.getName()) %></em><br />

<liferay-text-localizer:address-display
	address="<%= address %>"
/>

<c:if test="<%= address.isMailing() %>">(<liferay-ui:message key="mailing" />)</c:if>