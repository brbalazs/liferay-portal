{namespace DDMParagraph}

/**
 * Defines the delegated template for the paragraph field.
 */
{deltemplate ddm.field variant="'paragraph'"}
	{call .render data="all" /}
{/deltemplate}

/**
 * Prints the DDM form paragraph field.
 */
{template .render}
	{@param label: string}
	{@param name: string}
	{@param text: html}
	{@param visible: bool}

	<div class="form-group{$visible ? '' : ' hide'} liferay-ddm-form-field-paragraph" data-fieldname="{$name}">
		<fieldset>
			{if $label}
				<legend class="lfr-ddm-legend">{$label}</legend>
			{/if}

			<div>{$text}</div>
		</fieldset>
	</div>
{/template}