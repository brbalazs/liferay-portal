Bundle-Name: Liferay Portal Workflow API
Bundle-SymbolicName: com.liferay.portal.workflow.api
Bundle-Version: 3.0.5
Export-Package: com.liferay.portal.workflow.configuration
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.portal.workflow.lang)";\
		resource.bundle.base.name="content.Language"