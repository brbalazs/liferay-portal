Bundle-Name: Liferay Commerce Punch Out Web
Bundle-SymbolicName: com.liferay.commerce.punchout.web
Bundle-Version: 1.0.22
Import-Package:\
	com.liferay.commerce.model;version="[5.0.0,9999.0.0)",\
	com.liferay.commerce.product.service;version="[10.0.0,9999.0.0)",\
	\
	*
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.commerce.lang),(bundle.symbolic.name=com.liferay.commerce.punchout.lang)";\
		resource.bundle.base.name="content.Language"
Web-ContextPath: /commerce-punchout-web