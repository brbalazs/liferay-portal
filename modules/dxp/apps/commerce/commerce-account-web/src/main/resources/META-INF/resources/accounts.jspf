<liferay-frontend:add-menu
	inline="<%= true %>"
>
<liferay-frontend:add-menu-item
	title="<%= LanguageUtil.get(request, addButtonTitle) %>"
	type="<%= AddMenuKeys.AddMenuType.PRIMARY %>"
	url="<%= commerceAccountDisplayContext.getAddCommerceAccountHref() %>"
/>
</liferay-frontend:add-menu>

<div class="commerce-account-container" id="<portlet:namespace />entriesContainer">
	<aui:form action="<%= String.valueOf(portletURL) %>" name="searchFm">
		<div class="input-group">
			<div class="input-group-item">
				<input class="form-control input-group-inset input-group-inset-after" id="<portlet:namespace />keywords" name="<portlet:namespace />keywords" placeholder="<%= LanguageUtil.get(resourceBundle, "search") %>" title="<%= LanguageUtil.get(resourceBundle, "search") %>" type="text" value="<%= HtmlUtil.escapeAttribute(keywords) %>">

				<div class="input-group-inset-item input-group-inset-item-after">
					<button class="btn btn-unstyled d-md-inline-block d-none" type="submit">
						<svg aria-hidden="true" class="lexicon-icon lexicon-icon-search">
							<use xlink:href="<%= themeDisplay.getPathThemeImages() %>/lexicon/icons.svg#search">
						</svg>
					</button>
				</div>
			</div>
		</div>
	</aui:form>

<commerce-ui:table
	dataProviderKey="commerceAccounts"
	itemPerPage="<%= 5 %>"
	namespace="<%= renderResponse.getNamespace() %>"
	pageNumber="1"
	portletURL="<%= portletURL %>"
	tableName="commerceAccounts"
/>

	<aui:script>
		Liferay.Util.focusFormField('#<portlet:namespace />keywords');
	</aui:script>
</div>

<aui:script>
	function <portlet:namespace />addCommerceAccount(uri) {
		Liferay.Util.openWindow(
			{
				dialog: {
					centered: true,
					destroyOnClose: true,
					height: 600,
					modal: true,
					width: 700
				},
				dialogIframe: {
					bodyCssClass: 'dialog-with-footer'
				},
				id: 'commerceAccountDialog',
				title: '<liferay-ui:message key="add-account" />',
				uri: uri
			}
		);
	}

	Liferay.provide(
		window,
		'<portlet:namespace />closePopup',
		function(dialogId) {
			var dialog = Liferay.Util.Window.getById(dialogId);

			dialog.destroy();
		},
		['liferay-util-window']
	);

	Liferay.provide(
		window,
		'<portlet:namespace />refreshPortlet',
		function() {
			location.href = '<%= currentURL %>';
		},
		['aui-dialog', 'aui-dialog-iframe']
	);
</aui:script>