<div class="minium-frame__cta is-visible">
	<a class="minium-button minium-button--big" href="<%= commerceAccountDisplayContext.getAddCommerceAccountHref() %>">
		<%= LanguageUtil.get(request, addButtonTitle) %>
	</a>
</div>

<div class="commerce-account-container" id="<portlet:namespace />entriesContainer">
	<commerce-ui:table
		dataProviderKey="commerceAccounts"
		filter="<%= commerceAccountDisplayContext.getAccountFilter() %>"
		itemPerPage="<%= 5 %>"
		namespace="<%= renderResponse.getNamespace() %>"
		pageNumber="1"
		portletURL="<%= portletURL %>"
		tableName="commerceAccounts"
	/>

	<aui:script>
		Liferay.Util.focusFormField('#<portlet:namespace />keywords');
	</aui:script>
</div>


<div class="minium-frame__cta is-visible">
	<aui:button 
	cssClass="minium-button minium-button--big js-invite-user"
	onClick='<%= renderResponse.getNamespace() + "openUserInvitation();" %>'  value="invite-user" />
</div>

<commerce-ui:user-invitation
	componentId="userInvitation"
/>


<aui:script>

	Liferay.provide(
		window,
		'<portlet:namespace />openUserInvitation',
		function(evt) {
			const userInvitation = Liferay.component('userInvitation');
			console.log('open');
			userInvitation.open();
		}
	);

	function <portlet:namespace />addCommerceAccount(uri) {
		Liferay.Util.openWindow(
			{
				dialog: {
					centered: true,
					destroyOnClose: true,
					height: 600,
					modal: true,
					width: 700
				},
				dialogIframe: {
					bodyCssClass: 'dialog-with-footer'
				},
				id: 'commerceAccountDialog',
				title: '<liferay-ui:message key="add-account" />',
				uri: uri
			}
		);
	}

	Liferay.provide(
		window,
		'<portlet:namespace />closePopup',
		function(dialogId) {
			var dialog = Liferay.Util.Window.getById(dialogId);

			dialog.destroy();
		},
		['liferay-util-window']
	);

	Liferay.provide(
		window,
		'<portlet:namespace />refreshPortlet',
		function() {
			location.href = '<%= currentURL %>';
		},
		['aui-dialog', 'aui-dialog-iframe']
	);

</aui:script>