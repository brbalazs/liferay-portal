Bundle-Name: Liferay Commerce Initializer Beryl
Bundle-SymbolicName: com.liferay.commerce.initializer.beryl
Bundle-Version: 1.0.0
Import-Package:\
	!org.json,\
	\
	com.liferay.portal.kernel.dao.search;version="[7.2.0,8.0.0)",\
	com.liferay.portal.kernel.search;version="[7.5.0,8.0.0)",\
	\
	*
Require-Capability:\
	soy;\
		filter:="(type=commerce-cart-taglib)"
Web-ContextPath: /commerce-initializer-beryl
-dsannotations-options: inherit