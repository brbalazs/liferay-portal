{namespace ProductCard}

{template .render}

	{@param? accountId: number|string}
	{@param? orderId: number|string}
	{@param? availability: string}
	{@param? sku: string}
	{@param? skuId: number|string}
	{@param? pictureUrl: string}
	{@param name: string}
	{@param? cartAPI: string}
	{@param detailsLink: string}
	{@param? categories: list<[
		name: string
	]>}
	{@param? description: string}
	{@param? isCompareCheckboxVisible: bool}
	{@param? isInCompare: bool}
	{@param? isCompareAvailable: bool}
	{@param? isDeleteButtonVisible: bool}
	{@param settings: ? }
	{@param spritemap: string}
	{@param prices: ? }
	{@param? _handleCompareCheckbox: any}
	{@param? _handleRemoveProduct: any}

	<div class="product-card">
		{let $availabilityDotClasses kind="text"}
			d-inline-block minium-dot minium-dot--
			{switch $availability}
				{case 'inStock'}
					good
				{case 'available'}
					neutral
				{default}
					bad
			{/switch}
		{/let}

		{let $compareAttributes kind="attributes"}
			class="product-card__compare-checkbox"
			type="checkbox"
			{if isNonnull($isInCompare) and $isInCompare == true}
				{sp}checked
			{else}
				{if isNonnull($isCompareAvailable) and $isCompareAvailable == false}
					{sp}disabled
				{/if}
			{/if}
		{/let}

		{if isNonnull($isCompareCheckboxVisible) and $isCompareCheckboxVisible == true }
			<input
				{$compareAttributes}
				data-onchange="{$_handleCompareCheckbox}"
			/>
		{/if}

		{if isNonnull($isDeleteButtonVisible) and $isDeleteButtonVisible == true and isNonnull($spritemap)}
			<span
				class="product-card__delete"
				data-onclick={$_handleRemoveProduct}
			>
				{call ClayIcon.render}
					{param spritemap: $spritemap /}
					{param symbol: 'close' /}
				{/call}
			</span>
		{/if}

		{if isNonnull($pictureUrl)}
			<div
				class="product-card__picture"
				style="background-image: url({$pictureUrl})"
			></div>
		{else}
			<div
				class="product-card__picture"
			></div>
		{/if}

		{if isNonnull($availability)}
			<div class="product-card__availability">

			</div>
		{/if}

		{if isNonnull($sku)}
			<p class="product-card__sku">{$sku}</p>
		{else}
			<p class="product-card__empty_sku"></p>
		{/if}

		<a class="product-card__name" href="{$detailsLink}">{$name}</a>
		{if isNonnull($categories) and length($categories) > 0}
			<p class="product-card__categories">
				{foreach $category in $categories}
					{if index($category) != 0}
						,{sp}
					{/if}
					{$category.name}
				{/foreach}
			</p>
		{/if}

		{if isNonnull($description)}
			<p class="product-card__description">
				{$description}
			</p>
		{/if}

		<div class="product-card__price">
			{if isNonnull($prices) and isNonnull($prices)}
				{call Price.render}
					{param prices: $prices /}
					{param additionalPriceClasses: 'price--big' /}
					{param additionalDiscountedClasses: 'price--big' /}
				{/call}
			{/if}
		</div>

		{if isNonnull($sku) and  isNonnull($skuId)}
			<div>
				{call AddToCartButton.render}
					{param accountId: $accountId /}
					{param orderId: $orderId /}
					{param cartAPI: $cartAPI /}
					{param quantity: 0 /}
					{param editMode: false /}
					{param settings: $settings /}
					{param productId: $skuId /}
				{/call}
			</div>
		{else}
			<div>
				<a class="minium-button minium-button--outline" href="{$detailsLink}" target="_self">
					{msg desc=""}view-all{/msg}
				</a>
			</div>
		{/if}
	</div>

{/template}