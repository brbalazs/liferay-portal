{namespace MiniumSearchResults}

{template .render}
	{@param queryString: string }
	{@param results: ? }
	{@param visible: bool }

	{if $visible}
		<div class="minium-suggestions">
			<div class="minium-suggestions__wrapper">

				{foreach $item in $results}
					{delcall MiniumSearchResults.Item variant="$item.type"}
						{param queryString: $queryString /}
						{param item: $item /}
					{/delcall}
				{/foreach}

			</div>

			<div class="minium-suggestions__hints">
				<svg class="minium-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
					<rect fill="currentColor" x="5" y="5" width="90" height="90" rx="10" ry="10" />
				</svg> to navigate
				<svg class="minium-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
					<rect fill="currentColor" x="5" y="5" width="90" height="90" rx="10" ry="10" />
				</svg> to select
				<svg class="minium-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
					<rect fill="currentColor" x="5" y="5" width="90" height="90" rx="10" ry="10" />
				</svg> to dismiss
			</div>
		</div>
	{/if}
{/template}

{deltemplate MiniumSearchResults.Item}
	{@param queryString: string }
	{@param item: ? }

	<div
		class="minium-suggestions__item {if $item.selected}is-selected{/if}"
		data-onmouseenter="handleMouseEnter"
		data-onmouseleave="handleMouseLeave"
		data-pos="{$item.pos}"
	>
		<div class="minium-item minium-item--search">
			<img class="minium-item__image" src="{$item.image}" alt="">
			<div class="minium-item__content">
				{$item.title}<br>
				{$item.subtitle}
			</div>
		</div>
	</div>
{/deltemplate}

{deltemplate MiniumSearchResults.Item variant="'category'"}
	{@param queryString: string }
	{@param item: ? }

	<div
		class="minium-suggestions__item {if $item.selected}is-selected{/if}"
		data-onmouseenter="handleMouseEnter"
		data-onmouseleave="handleMouseLeave"
		data-pos="{$item.pos}"
	>
		Search "{$queryString}" in {$item.value}
	</div>
{/deltemplate}

{deltemplate MiniumSearchResults.Item variant="'label'"}
	{@param queryString: string }
	{@param item: ? }

	<div class="minium-suggestions__label">
		{$item.value}
	</div>
{/deltemplate}