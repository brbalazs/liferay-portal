<?xml version="1.0"?>

<FindBugsFilter>
	<Match>
		<Class name="~com\.liferay\.commerce\.data\.integration\.manager\.model\.impl\..+Impl" />
		<Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS" />
	</Match>
	<Match>
		<Class name="~com\.liferay\.commerce\.data\.integration\.manager\.model\.impl\..+ModelImpl" />
		<Or>
			<And>
				<Field name="TABLE_COLUMNS_MAP" />
				<Bug pattern="MS_MUTABLE_COLLECTION" />
			</And>
			<And>
				<Field name="TABLE_COLUMNS_MAP" />
				<Bug pattern="MS_MUTABLE_COLLECTION_PKGPROTECT" />
			</And>
			<And>
				<Method name="clone" />
				<Bug pattern="CN_IDIOM_NO_SUPER_CALL" />
			</And>
			<And>
				<Method name="equals" />
				<Bug pattern="EQ_UNUSUAL" />
			</And>
			<And>
				<Method name="~get.*Date" />
				<Bug pattern="EI_EXPOSE_REP" />
			</And>
			<And>
				<Method name="~set.*Date" />
				<Bug pattern="EI_EXPOSE_REP2" />
			</And>
		</Or>
	</Match>
</FindBugsFilter>