enum AcquisitionType {
	CHANNEL
	REFERRER
	SOURCE_MEDIUM
}

enum AnalysisType {
	AVERAGE
	TOTAL
	UNIQUE
}

enum AssetType {
	BLOG
	DOCUMENT
	FORM
	JOURNAL
	PAGE
}

enum AttributeType {
	EVENT,
	INDIVIDUAL,
	USER_SESSION
}

enum DataControlTaskStatus {
	COMPLETED
	ERROR
	EXPIRED
	PENDING
	RUNNING
}

enum DataControlTaskType {
	ACCESS
	DELETE
	SUPPRESS
	UNSUPPRESS
}

enum DataSourceConfigurationStatus {
	CONFIGURED
	UNCONFIGURED
}

enum DateGrouping {
	DAY
	MONTH
	YEAR
}

enum EntityType {
	INDIVIDUAL
}

enum EventAttributeDefinitionDataType {
	BOOLEAN
	DATE
	DURATION
	NUMBER
	STRING
}

enum EventAttributeDefinitionType {
	ALL
	GLOBAL
	LOCAL
}

enum EventDefinitionType {
	ALL
	CUSTOM
	DEFAULT
}

enum JobRunStatus {
	COMPLETED
	FAILED
	PUBLISHED
	RUNNING
}

enum JobRunDataPeriod {
	LAST_7_DAYS
	LAST_30_DAYS
	LAST_180_DAYS
	LAST_365_DAYS
}

enum JobRunFrequency {
	EVERY_7_DAYS
	EVERY_14_DAYS
	EVERY_30_DAYS
	MANUAL
}

enum JobStatus {
	FAILED
	PENDING
	READY
	RUNNING
	SCHEDULED
}

enum JobType {
	COMMERCE_DEMAND_FORECAST_PRODUCT
	COMMERCE_PRODUCT_RECOMMENDATION_FREQUENT_PATTERN
	COMMERCE_PRODUCT_RECOMMENDATION_PRODUCT_CONTENT
	COMMERCE_PRODUCT_RECOMMENDATION_USER_INTERACTION
	COMMERCE_REVENUE_FORECAST_ACCOUNT
	COMMERCE_REVENUE_FORECAST_ACCOUNT_CATEGORY
	CONTENT_RECOMMENDATION_ITEM_SIMILARITY
}

enum SortType {
	ASC
	DESC
}

input DXPVariantSettings {
	control: Boolean!
	dxpVariantId: String!
	trafficSplit: Float!
}

input EventAnalysisBreakdownInput {
	attributeId: String!
	attributeType: AttributeType!
	binSize: Float
	dataType: EventAttributeDefinitionDataType!
	dateGrouping: DateGrouping
	description: String
	displayName: String!
	sortType: SortType
}

input EventAnalysisFilterInput {
	attributeId: String!
	attributeType: AttributeType!
	dataType: EventAttributeDefinitionDataType!
	description: String
	displayName: String!
	operator: String!
	values: [String]!
}

input ExperimentSettings {
	confidenceLevel: Float!
	dxpVariantsSettings: [DXPVariantSettings]!
}

input JobParameterInput {
	name: String!
	value: String!
}

input PropertyFilter {
	negate: Boolean!
	filter: String!
}

input Sort {
	column: String!
	type: SortType!
}

interface AssetMetric {
	assetId: String
	assetMetrics: [AssetMetric]
	assetTitle: String
	assetType: String
	dataSourceId: String
	defaultMetric: Metric
	urls: [String]
}

schema {
	query: QueryType
	mutation: MutationType
}

type Activity {
	applicationId: String
	eventContext: String
	eventId: String
	eventProperties: String
	ownerId: String
	startTime: String
}

type ActivityBag {
	activities: [Activity]
	total: Int
}

type AssetMetricBag {
	assetMetrics: [AssetMetric]
	total: Int
}

type AudienceReport {
    anonymousUsersCount: Int
    knownUsersCount: Int
    nonsegmentedKnownUsersCount: Int
    segmentedAnonymousUsersCount: Int
    segmentedKnownUsersCount: Int
}

type BaseDXPEntity implements DXPEntity {
	dataSourceName: String
	id: String
	name: String
}

type BlockedCustomEventDefinition {
	hidden: Boolean
	id: String
	lastSeenDate: String
	lastSeenURL: String
	name: String
}

type BlockedCustomEventDefinitionBag {
	blockedCustomEventDefinitions: [BlockedCustomEventDefinition]
	total: Int
}

