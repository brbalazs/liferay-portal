	assetId: String
	assetMetrics: [AssetMetric]
	assetTitle: String
	assetType: String
	canonicalUrls: [String]
	commentsMetric: Metric
	dataSourceId: String
	defaultMetric: Metric
	ratingsMetric: Metric
	readingTimeMetric: Metric
	urls: [String]
	viewsMetric: Metric
}

type BreakdownItem {
	breakdownItems: [BreakdownItem]
	leafNode: Boolean
	name: String
	previousValue: Float
	value: Float
}

type CohortHeatMapMetric {
	colDimension: String
	retention: Float
	rowDimension: String
	rowKey: String
