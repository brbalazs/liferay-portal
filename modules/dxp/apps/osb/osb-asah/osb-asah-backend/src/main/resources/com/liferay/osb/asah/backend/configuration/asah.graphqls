	knownCohortHeatMapMetrics: [CohortHeatMapMetric]
	visitorsCohortHeatMapMetrics: [CohortHeatMapMetric]
}

type Composition {
	name: String
	count: Int
}

type CompositionBag {
	compositions: [Composition]
	maxCount: Int
	total: Int
	totalCount: Int
}

type CurrencyValue {
	currencyCode: String,
	trend: Trend,
	value: String
}

type CustomAssetMetric implements AssetMetric {
	abandonmentsMetric: Metric
