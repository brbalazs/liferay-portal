	value: Float
	valueKey: String
}

type HistogramMetricBag {
	asymmetricComparison: Boolean
	metrics: [HistogramMetric]
	total: Int
}

type Individual {
	email: String
	id: String
	name: String
}

type IndividualBag {
	individuals: [Individual],
	total: Int
}

type IndividualMetric {
	anonymousIndividualsMetric: Metric
	knownIndividualsMetric: Metric
	totalIndividualsMetric: Metric
}

type KeyValuePair {
	key: String
	value: String
}

type Keyword {
	type: String
	value: String
}

type Job {
	id: String
	name: String
	nextRunDate: String
	parameters: [JobParameter]
	status: JobStatus
	runDate: String
	runFrequency: JobRunFrequency
	runDataPeriod: JobRunDataPeriod
	type: JobType
}

type JobBag {
	jobs: [Job]
	total: Int
}

type JobParameter {
	name: String
	value: String
}

type JobRun {
	id: String
	completedDate: String
	context: [KeyValuePair]
	status: JobRunStatus
}

type JobRunBag {
	jobRuns: [JobRun]
	total: Int
}

type JobRunsMonthlyStatistics {
	availableJobRuns: Int
	completedJobRuns: Int
	failedJobRuns: Int
	publishedJobRuns: Int
	runningJobRuns: Int
	scheduledJobRuns: Int
}

type JournalMetric implements AssetMetric {
	assetId: String
	assetMetrics: [AssetMetric]
	assetTitle: String
	assetType: String
	canonicalUrls: [String]
	dataSourceId: String
	defaultMetric: Metric
	urls: [String]
	viewsMetric: Metric
}

type Metric {
	anonymousUsersCount: Int
	audienceReport: AudienceReport
	browser: [Metric]
	cohortHeatMap: [CohortHeatMapMetric]
	device: [Metric]
	geolocation: [Metric]
	histogram: HistogramMetricBag
	individuals(keywords: String, size: Int!, start: Int!): IndividualBag
	knownUsersCount: Int
	metrics: [Metric]
	nonsegmentedKnownUsersCount: Int
	previousValue: Float
	previousValueKey: String
	segment: MetricBag
	segmentedAnonymousUsersCount: Int
	segmentedKnownUsersCount: Int
	trend: Trend
	value: Float
	valueKey: String
}

type MetricBag {
	metrics: [Metric]
	total: Int
}

type MutationType {
	blockCustomEventDefinitions(
		eventDefinitionIds: [String]!
	): [Boolean]

	createEventAnalysis(
		analysisType: AnalysisType!
		channelId: String!
		compareToPrevious: Boolean!
		eventAnalysisBreakdowns: [EventAnalysisBreakdownInput]
		eventAnalysisFilters: [EventAnalysisFilterInput]
		eventDefinitionId: String!
		name: String!
		rangeEnd: String
		rangeKey: Int
		rangeStart: String
		userId: String!
		userName: String!
	): EventAnalysis

	createJob(
		name: String!
		parameters: [JobParameterInput]
		runDataPeriod: JobRunDataPeriod
		runFrequency: JobRunFrequency
		runNow: Boolean
		type: JobType!
	): Job

	dashboard(
		dashboardId: String!
		definition: String!
		modifiedByUserId: String!
		modifiedByUserName: String!
	): Dashboard

	dataControlTasks(
		emailAddresses: [String]
		fileName: String
		ownerId: String!
		types: [DataControlTaskType]!
		userId: String!
		userName: String!
	): Boolean

	deleteEventAnalyses(
		eventAnalysisIds: [String]!
	): [Boolean]

	deleteExperiment(
		experimentId: String!
	): Boolean

	deleteJobs(
		jobIds: [String]!
	): [Boolean]

	experiment(
		experimentId: String!
		experimentSettings: ExperimentSettings
		publishedDXPVariantId: String
		status: String
	): Experiment

	hideBlockedEventDefinitions(
		blockedEventDefinitionIds: [String]!
	): [BlockedCustomEventDefinition]

	hideEventDefinitions(
		eventDefinitionIds: [String]!
	): [EventDefinition]

	preference(
		key: String!
		value: String!
	): Preference

	runJob(
		jobId: String!,
		runDataPeriod: JobRunDataPeriod!
	): Job

	timeZone(
		value: String!
	): String

	unblockCustomEventDefinitions(
		eventDefinitionIds: [String]!
	): [Boolean]

	unhideBlockedEventDefinitions(
		blockedEventDefinitionIds: [String]!
	): [BlockedCustomEventDefinition]

	unhideEventDefinitions(
		eventDefinitionIds: [String]!
	): [EventDefinition]

	updateEventAnalysis(
		analysisType: AnalysisType!
		channelId: String!
		compareToPrevious: Boolean!
		eventAnalysisBreakdowns: [EventAnalysisBreakdownInput]
		eventAnalysisFilters: [EventAnalysisFilterInput]
		eventAnalysisId: String!
		eventDefinitionId: String!
		name: String!
		rangeEnd: String
		rangeKey: Int
		rangeStart: String
		userId: String!
		userName: String!
	): EventAnalysis

	updateEventAttributeDefinition(
		dataType: EventAttributeDefinitionDataType
		description: String
		displayName: String
		eventAttributeDefinitionId: String!
	): EventAttributeDefinition

	updateEventDefinition(
		description: String
		displayName: String
		eventDefinitionId: String!
	): EventDefinition

	updateJob(
		jobId: String!
		name: String!
		parameters: [JobParameterInput]
		runDataPeriod: JobRunDataPeriod
		runFrequency: JobRunFrequency
		runNow: Boolean
	): Job
}

