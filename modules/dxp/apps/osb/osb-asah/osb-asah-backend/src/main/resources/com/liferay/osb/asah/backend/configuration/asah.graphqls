interface DXPEntity {
	dataSourceName: String
	id: String
	name: String
}

type DXPEntityBag {
	dxpEntities: [DXPEntity]
	total: Int
}

type Event {
	canonicalUrl: String,
	createDate: String,
	name: String,
	pageDescription: String,
	pageKeywords: String,
	pageTitle: String,
	referrer: String,
	url: String
}

type EventAnalysis {
	analysisType: AnalysisType
	channelId: String
	compareToPrevious: Boolean
	createDate: String
	createdByUserId: String
	createdByUserName: String
	eventAnalysisBreakdowns: [EventAnalysisBreakdown]
	eventAnalysisFilters: [EventAnalysisFilter]
	eventDefinitionId: String
	id: String
	modifiedDate: String
	modifiedByUserId: String
	modifiedByUserName: String
	name: String
	rangeEnd: String
	rangeKey: Int
	rangeStart: String
	referencedObjects: EventAnalysisReferencedObject
}

type EventAnalysisBag {
	eventAnalyses: [EventAnalysis]
	total: Int
}

type EventAnalysisBreakdown {
	attributeId: String
	attributeType: String
	binSize: Float
	dataType: String
	dateGrouping: String
	description: String
	displayName: String
	sortType: String
}

type EventAnalysisFilter {
	attributeId: String
	attributeType: String
	dataType: String
	description: String
	displayName: String
	operator: String
	values: [String]
}

type EventAnalysisReferencedObject {
	eventAttributeDefinitions: [EventAttributeDefinition]
	eventDefinition: EventDefinition
}

type EventAnalysisResult {
	breakdownItems: [BreakdownItem]
	count: Int
	page: Int
	previousValue: Float
	value: Float
}

type EventAttributeDefinition {
	dataType: EventAttributeDefinitionDataType
	description: String
	displayName: String
	id: String
	name: String
	recentValues: [EventAttributeValue]
	sampleValue: String
	type: EventAttributeDefinitionType
}

type EventAttributeDefinitionBag {
	eventAttributeDefinitions: [EventAttributeDefinition]
	total: Int
}

type EventAttributeValue {
	lastSeenDate: String
	value: String
}

type EventAttributeValueBag {
	eventAttributeValues: [String]
	total: Int
}

type EventDefinition {
	description: String
	displayName: String
	eventAttributeDefinitions: [EventAttributeDefinition]
	id: String
	hidden: Boolean
	name: String
	type: EventDefinitionType
}

type EventDefinitionBag {
	eventDefinitions: [EventDefinition]
	total: Int
}

type EventMetric {
	totalEventsMetric: Metric
	totalSessionsMetric: Metric
}

type EventsByUserSession {
	userSessions: [UserSession],
	totalEvents: Int
}

type Experiment {
	channelId: String
	createDate: String
	dataSourceId: String
	description: String
	dxpExperienceName: String
	dxpSegmentName: String
	dxpVariants: [ExperimentVariant]
	finishedDate: String
	goal: Goal
	id: String
	metrics: ExperimentMetric
	metricsHistogram: [ExperimentMetric]
	modifiedDate: String
	name: String
	pageURL: String
	publishable: Boolean
	publishedDXPVariantId: String
	sessions: Int
	sessionsHistogram: [HistogramMetric]
	startedDate: String
	status: String
	type: String
	winnerDXPVariantId: String
}

type ExperimentBag {
	experiments: [Experiment]
	total: Int
}

type ExperimentMetric {
	completion: Float
	confidenceLevel: Float
	elapsedDays: Int
	estimatedDaysLeft: Int
