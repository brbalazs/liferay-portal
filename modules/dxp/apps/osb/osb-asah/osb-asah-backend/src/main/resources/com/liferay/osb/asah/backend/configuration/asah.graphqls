	variantMetrics: [ExperimentVariantMetric]
}

type ExperimentVariant {
	changes: Int
	control: Boolean
	dxpVariantId: String
	dxpVariantName: String
	sessionsHistogram: [HistogramMetric]
	trafficSplit: Float
	uniqueVisitors: Int
}

type ExperimentVariantMetric {
	confidenceInterval: [Float]
	dxpVariantId: String
	improvement: Float
	median: Float
	probabilityToWin: Float
}

