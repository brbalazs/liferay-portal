    </div>
  </div>
</Connect(SettingsBasePage)>
`;

exports[`UsageOverview should render with a member-specific message overage warning if a metric is approaching plan limit and the user is a member role 1`] = `
<Alert
  iconSymbol="exclamation-full"
  key="pageViews"
  title="Usage Limit Approaching"
  type="warning"
>
  The current plan can only support another 
  <b
    key="pageViews"
  >
    6,899,977
  </b>
   
  page views
  . Please contact your site administrator to upgrade the plan.
</Alert>
`;

exports[`UsageOverview should render with an approaching limit warning if a metric is approaching plan limit 1`] = `
<Alert
  iconSymbol="exclamation-full"
  key="pageViews"
  title="Usage Limit Approaching"
  type="warning"
>
  The current plan can only support another 
  <b
    key="pageViews"
  >
    7,000,000
  </b>
   
  page views
  . Please contact a sales representative to upgrade the plan.
</Alert>
`;

exports[`UsageOverview should render with an overage warning if a metric has exceeded the plan limit 1`] = `
<Alert
  iconSymbol="exclamation-full"
  key="individuals"
  title="Usage Limit Exceeded"
  type="danger"
>
  The current plan's 
  <b
    key="individuals"
  >
    individuals
  </b>
   limit has been exceeded. Please contact a sales representative at the earliest convenience.
</Alert>
`;

