          Data Sources
        </a>
      </li>
      <li
        class="breadcrumb-item active"
      >
        <span
          class="breadcrumb-text-truncate"
        >
          Liferay1
        </span>
      </li>
    </ol>
    <div
      class="content-header has-page-actions"
    >
      <div
        class="header-text"
      >
        <h3>
          <span
            class="text-truncate"
            data-tooltip="false"
            title=""
          >
            Configure Liferay DXP
          </span>
        </h3>
        <div
          class="description"
        >
          Liferay1 - https://www.faro-1.io
        </div>
      </div>
      <div
        class="page-actions-container"
      >
        <button
          class="button-root btn btn-secondary"
          type="button"
        >
          Delete Data Source
        </button>
      </div>
    </div>
    <div>
      <div
        class="page-container"
      >
        <div
          class="content-main"
        >
          <div
            class="sheet data-source-base-tabs-root page-display"
          >
            <div
              class="sheet-body"
            >
              <ul
                class="nav-root nav nav-underline"
                role="tablist"
              >
                <li
                  class="nav-item active"
                  role="presentation"
                >
                  <a
                    class="nav-link active"
                    href="/workspace/foo/settings/data-source/test"
                    role="tab"
                  >
                    <h4>
                      Authorization
                    </h4>
                  </a>
                </li>
                <li
                  class="nav-item"
                  role="presentation"
                >
                  <a
                    class="nav-link"
                    href="/workspace/foo/settings/data-source/test/liferay/configuration-status"
                    role="tab"
                  >
                    <h4>
                      Configure Data Source
                    </h4>
                    <span
                      class="badge badge-primary ml-2"
                    >
                      <span
                        class="badge-item badge-item-expand"
                      >
                        2
                      </span>
                    </span>
                  </a>
                </li>
              </ul>
            </div>
            <form
              class="form-root oauth-form-root"
            >
              <div
                class="sheet-body"
              >
                <div
                  class="sheet-section"
                >
                  <div
                    class="sheet-text"
                  >
                    Please enter the URL of the target instance to start configuring the 
                    Liferay
                     Data Source. You will need to enter the credentials of the data source's administrator. If you need help setting this up, please refer to the 
                    <a
                      href="https://help.liferay.com/hc/en-us/articles/360006653472-Adding-a-Liferay-DXP-Data-Source"
                    >
                      documentation
                    </a>
                    .
                  </div>
                  <div
                    class="callback-url"
                  >
                    <b>
                      Analytics Cloud Callback URL:
                    </b>
                    <pre>
                      http://liferay.com/oauth/receive
                    </pre>
                  </div>
                </div>
                <div
                  class="sheet-section"
                >
                  <h3
                    class="sheet-subtitle"
                  >
                    Data Source
                  </h3>
                  <div
                    class=""
                  >
                    <label
                      class="form-control-label label-root required"
                      for="dataSourceName"
                    >
                      <span
                        class="content-container"
                      >
                        Name
                      </span>
                    </label>
                    <input
                      class="input-root form-control"
                      disabled=""
                      id="dataSourceName"
                      name="dataSourceName"
                      type="text"
                      value="Liferay1"
                    />
                  </div>
                  <div
                    class=""
                  >
                    <label
                      class="form-control-label label-root required"
                      for="url"
                    >
                      <span
                        class="content-container"
                      >
                        URL
                      </span>
                    </label>
                    <input
                      class="input-root form-control"
                      disabled=""
                      id="url"
                      name="url"
                      type="text"
                      value="https://www.faro-1.io"
                    />
                  </div>
                </div>
                <div
                  class="sheet-section"
                >
                  <h3
                    class="sheet-subtitle"
                  >
                    Client Credentials
                  </h3>
                  <div
