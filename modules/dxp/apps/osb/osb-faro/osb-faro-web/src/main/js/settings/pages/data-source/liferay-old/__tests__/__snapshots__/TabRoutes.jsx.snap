                      disabled=""
                      id="consumerKey"
                      name="consumerKey"
                      type="text"
                      value=""
                    />
                  </div>
                  <div
                    class=""
                  >
                    <label
                      class="form-control-label label-root required"
                      for="consumerSecret"
                    >
                      <span
                        class="content-container"
                      >
                        Consumer Secret/Client Secret
                      </span>
                    </label>
                    <div
                      class="input-group"
                    >
                      <div
                        class="input-group-item"
                      >
                        <input
                          autocomplete="new-password"
                          class="input-root form-control input-group-inset input-group-inset-after"
                          disabled=""
                          id="consumerSecret"
                          name="consumerSecret"
                          type="password"
                          value=""
                        />
                        <div
                          class="input-group-inset-item input-group-inset-item-after"
                        >
                          <button
                            class="button-root btn btn-unstyled"
                            disabled=""
                            type="button"
                          >
                            <svg
                              class="icon-root lexicon-icon lexicon-icon-view"
                              viewBox=""
                            >
                              <use
                                xlink:href="/o/osb-faro-web/dist/sprite.svg#view"
                              />
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  class="sheet-section"
                >
                  <h5>
                    OAuth Owner
