                >
                  <span
                    class="label-item"
                  >
                    Authenticated
                  </span>
                </div>
              </div>
            </div>
            <div
              class="panel-body"
            >
              You have successfully authenticated your client id and secret with you data source. You can now configure your data.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
