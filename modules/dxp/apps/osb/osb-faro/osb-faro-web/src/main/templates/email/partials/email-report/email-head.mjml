<mj-head>
	<mj-include path="../head.mjml" />

	<mj-style>
		.header-title div { text-align: left !important; color: white
		!important; font-size: 40px !important; font-weight: 700 !important
		font-family: Source Sans Pro !important; }
	</mj-style>
	<mj-style inline="inline"> .strong-text { color: #272833; } </mj-style>
	<mj-style>
		.table-title div { font-size: 16px !important; font-family: Source Sans
		Pro !important; color: #272833 !important; font-weight: 600 !important;}
	</mj-style>
	<mj-style>
		.small-text div { font-size: 14px !important; color: #6B6C7E !important;
		font-weight: 700 !important;}
	</mj-style>
	<mj-style>
		.activities-title div { text-align: center !important; font-size: 24px
		!important; color: #272833 !important; font-weight: 700 !important;
		padding: 48px 0 !important}
	</mj-style>
	<mj-style>
		.activities-data div { font-size:40px !important; color: #272833
		!important; font-weight: 700 !important; }
	</mj-style>

	<mj-style>
		.activities-comparisson div { font-size:24px !important; color: #272833
		!important; font-weight: 700 !important; }
	</mj-style>
	<mj-style>
		td.small-text, td.activities-data, td.activities-comparisson,
		td.body-text, td.footer-text { padding: 0 !important}
	</mj-style>
	<mj-style>
		.activities-comparisson-container div { text-align: end !important;}
	</mj-style>
	<mj-style>
		.body-text div { text-align: center !important; font-size: 16px
		!important;}
	</mj-style>
	<mj-style>
		.footer-text div { text-align: center !important; font-size: 14px
		!important; color: #6B6C7E !important;}
	</mj-style>
	<mj-style>
		a { text-decoration: none !important; color: #0b5fff !important; }
	</mj-style>
	<mj-style>
		a.nav-link { text-transform: none !important; color: #0b5fff !important;
		}
	</mj-style>
</mj-head>
