<mj-head>
	<mj-include path="../head.mjml" />

	<mj-style>
		a {
			color: #0b5fff !important;
			text-decoration: none !important;
		}
	</mj-style>
	<mj-style>
		a.nav-link {
			color: #0b5fff !important;
			text-transform: none !important;
		}
	</mj-style>
	<mj-style>
		.activities-comparison div {
			color: #272833 !important;
			font-size:24px !important;
			font-weight: 700 !important;
		}
	</mj-style>
	<mj-style>
		.activities-comparison-container div {
			text-align: end !important;
		}
	</mj-style>
	<mj-style>
		.activities-data div {
			color: #272833 !important;
			font-size:40px !important;
			font-weight: 700 !important;
		}
	</mj-style>
	<mj-style>
		.activities-title div {
			color: #272833 !important;
			font-size: 24px !important;
			font-weight: 700 !important;
			padding: 48px 0 !important;
			text-align: center !important;
		}
	</mj-style>
	<mj-style>
		.body-text div {
			font-size: 16px !important;
			text-align: center !important;
		}
	</mj-style>
	<mj-style>
		.footer-text div {
			color: #6B6C7E !important;
			font-size: 14px !important;
			text-align: center !important;
		}
	</mj-style>
	<mj-style>
		.header-title div {
			color: white !important;
			font-family: Source Sans Pro !important;
			font-size: 40px !important;
			font-weight: 700 !important
			text-align: left !important;
		}
	</mj-style>
	<mj-style>
		.small-text div {
			color: #6B6C7E !important;
			font-size: 14px !important;
			font-weight: 700 !important;
		}
	</mj-style>
	<mj-style inline="inline">
		.strong-text {
			color: #272833;
		}
	</mj-style>
	<mj-style>
		.table-title div {
			color: #272833 !important;
			font-family: Source Sans Pro !important;
			font-size: 16px !important;
			font-weight: 600 !important;
		}
	</mj-style>
	<mj-style>
		td.activities-data, td.activities-comparison, td.body-text,
		td.footer-text, td.small-text {
			padding: 0 !important
		}
	</mj-style>
</mj-head>
