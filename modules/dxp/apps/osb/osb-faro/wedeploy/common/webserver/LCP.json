{
	"cpu": 2,
	"dependencies": [
		"liferay"
	],
	"id": "webserver",
	"image": "liferaycloud/nginx:1.16.1-4.0.4",
	"livenessProbe": {
		"failureThreshold": 20,
		"httpGet": {
			"path": "/nginx_status",
			"port": 80
		},
		"initialDelaySeconds": 360,
		"timeoutSeconds": 10
	},
	"loadBalancer": {
		"cdn": true,
		"targetPort": 80
	},
	"memory": 512,
	"readinessProbe": {
		"failureThreshold": 20,
		"httpGet": {
			"path": "/nginx_status",
			"port": 80
		},
		"initialDelaySeconds": 360,
		"timeoutSeconds": 10
	},
	"strategy": {
		"type": "RollingUpdate"
	},
	"volumes": {
		"data": "/data"
	}
}