Bundle-Name: Liferay Portal Reports Engine Console Service
Bundle-SymbolicName: com.liferay.portal.reports.engine.console.service
Bundle-Version: 5.0.8
DynamicImport-Package: *
Export-Package:\
	com.liferay.portal.reports.engine.console.configuration,\
	com.liferay.portal.reports.engine.console.service.permission,\
	com.liferay.portal.reports.engine.console.util
Import-Package:\
	!net.sf.cglib.proxy.*,\
	\
	*
Liferay-Releng-Module-Group-Title: Reports Engine Console
Liferay-Require-SchemaVersion: 1.0.1
Liferay-Service: true
-includeresource: @com.liferay.util.java-[0-9.]*(-SNAPSHOT|-TEST_ARTIFACT|).jar!/com/liferay/util/portlet/PortletProps.class