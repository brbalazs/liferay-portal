definition {

	macro getClientVersion {
		var serverVersion = Elasticsearch.getServerVersion();

		var majorVersion = StringUtil.extractFirst(${serverVersion}, ".");
		var projectDir = PropsUtil.get("project.dir");

		var fileContent = FileUtil.read("${projectDir}/modules/apps/portal-search-elasticsearch${majorVersion}/portal-search-elasticsearch${majorVersion}-impl/build.gradle");

		var clientVersion = RegexUtil.replace(${fileContent}, "elasticsearchVersion = \"(\d+\.\d+\.\d+)", 1);

		echo("Elasticsearch client version: ${clientVersion}");

		return ${clientVersion};
	}

	macro getServerVersion {
		if (!(isSet(port))) {
			var port = 9200;
		}

		var curl = "http://localhost:${port}";

		var serverInfo = JSONCurlUtil.get(${curl});

		var serverVersion = RegexUtil.replace(${serverInfo}, "number\" : \"(\d+\.\d+\.\d+)", 1);

		echo("Version of the Elasticsearch server on port ${port}: ${serverVersion}");

		return ${serverVersion};
	}

	macro viewClusterStatus {
		AssertTextPresent(
			locator1 = "//pre",
			value1 = ${clusterStatus});
	}

	@description = "Elasticsearch provides a Cluster Health API (http://localhost:9200/_cluster/health?pretty=true) to easily view the current status of the cluster."
	macro viewClusterStatusViaClusterHealthAPI {
		var portalHostname = PropsUtil.get("portal.hostname");

		var curl = "http://${portalHostname}:9200/_cluster/health?level=indices";

		var clusterHealth = JSONCurlUtil.get(${curl});

		TestUtils.assertPartialEquals(
			actual = ${clusterHealth},
			expected = "\"cluster_name\":\"LiferayElasticsearchCluster\"");

		TestUtils.assertPartialEquals(
			actual = ${clusterHealth},
			expected = "\"number_of_nodes\":${numberOfNodes}");

		TestUtils.assertPartialEquals(
			actual = ${clusterHealth},
			expected = "\"number_of_data_nodes\":${numberOfNodes}");
	}

}