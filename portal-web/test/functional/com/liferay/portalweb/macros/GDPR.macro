definition {

	@summary = "Default summary"
	macro addExportProcessCP(userLastName = null, userFirstName = null, applications = null) {
		var key_application = ${application};

		LexiconEntry.gotoAdd();

		AssertElementPresent(
			key_firstName = ${userFirstName},
			key_lastName = ${userLastName},
			locator1 = "ExportPersonalData#ADD_PROCESS_HEADER");

		if (isSet(applications)) {
			for (var application : list ${applications}) {
				Check(
					key_application = ${application},
					locator1 = "ExportPersonalData#APPLICATION_CHECKBOX");
			}
		}
		else {
			PortletEntry.selectAll();
		}

		AssertClick(
			locator1 = "Button#EXPORT",
			value1 = "Export");

		Alert.viewSuccessMessage();

		AssertElementPresent(
			key_firstName = ${userFirstName},
			key_lastName = ${userLastName},
			locator1 = "ExportPersonalData#HEADER");

		while (IsElementPresent(locator1 = "ExportPersonalData#EXPORT_PROCESS_IN_PROGRESS")) {
			Pause(value1 = 3000);
		}

		AssertElementPresent(locator1 = "ExportPersonalData#EXPORT_PROCESS_SUCCESSFUL");

		if (isSet(applications)) {
			for (var application : list ${applications}) {
				AssertElementPresent(
					key_application = ${application},
					locator1 = "ExportPersonalData#EXPORT_PROCESS_SPECIFIC_APPLICATION_SUCCESSFUL");
			}
		}
	}

	@summary = "Default summary"
	macro anonymizeDataViaReviewData(application = null) {
		Click(
			key_application = ${application},
			locator1 = "DataErasure#REVIEW_DATA_APPLICATION_ELLIPSIS");

		MenuItem.clickNoError(menuItem = "Anonymize");

		Alert.viewSuccessMessage();
	}

	@summary = "Default summary"
	macro deactivateUser(userLastName = null, userFirstName = null) {
		AssertElementPresent(
			key_firstName = ${userFirstName},
			key_lastName = ${userLastName},
			locator1 = "DataErasure#HEADER");

		Button.clickNoError(button = "Deactivate User");

		AssertConfirm(value1 = "Are you sure you want to deactivate the user?");

		Alert.viewSuccessMessage();
	}

	@summary = "Default summary"
	macro deletePersonalApplicationsData(rowEntry = null, applications = null) {
		AssertTextEquals(
			locator1 = "DataErasure#SHEET_TITLE",
			value1 = "Application Data Review");

		LexiconEntry.gotoEntry(rowEntry = ${applications});

		LexiconEntry.gotoEntryMenuItemNoError(
			menuItem = "Delete",
			rowEntry = ${rowEntry});

		AssertConfirm(value1 = "Are you sure you want to delete this entity?");

		Alert.viewSuccessMessage();

		LexiconEntry.viewNoEntry(rowEntry = ${rowEntry});
	}

	@summary = "Default summary"
	macro deletePersonalSite(userLastName = null, userFirstName = null) {
		AssertElementPresent(
			key_firstName = ${userFirstName},
			key_lastName = ${userLastName},
			locator1 = "DataErasure#HEADER");

		if (IsElementNotPresent(key_text = "Delete Personal Site", locator1 = "Button#ANY_DISABLED")) {
			Button.clickNoError(button = "Delete Personal Site");

			AssertConfirm(value1 = "Are you sure you want to delete the user's personal site?");

			Alert.viewSuccessMessage();
		}
	}

	@summary = "Default summary"
	macro downloadExportedPersonalData(applications = null) {
		for (var application : list ${applications}) {
			var key_rowEntry = ${application};

			Click(locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_ELLIPSIS");

			AssertClick.assertPartialTextClickAt(
				locator1 = "MenuItem#DOWNLOAD",
				value1 = "Download");
		}
	}

	@summary = "Default summary"
	macro editPersonalApplicationsData(rowEntry = null, applications = null) {
		AssertTextEquals(
			locator1 = "DataErasure#SHEET_TITLE",
			value1 = "Application Data Review");

		LexiconEntry.gotoEntry(rowEntry = ${applications});

		LexiconEntry.gotoEntryMenuItemNoError(
			menuItem = "Edit",
			rowEntry = ${rowEntry});
	}

	@summary = "Default summary"
	macro reviewPersonalData(userLastName = null, userFirstName = null, itemsCount = null, applications = null) {
		AssertElementPresent(
			key_firstName = ${userFirstName},
			key_lastName = ${userLastName},
			locator1 = "DataErasure#HEADER");

		Button.clickNoError(button = "Review");

		AssertTextEquals.assertPartialText(
			key_itemsCount = ${itemsCount},
			locator1 = "DataErasure#REMAINING_ITEMS_COUNT",
			value1 = "Remaining Items: ${itemsCount}");

		AssertTextEquals.assertPartialText(
			key_rowEntry = ${applications},
			locator1 = "ContentRow#ENTRY_CONTENT_ROW_TD_2",
			value1 = ${itemsCount});
	}

	@summary = "Default summary"
	macro viewEntryRowInApplicationCP(tableEntry = null, tableEntryPartialTextList = null) {
		for (var tableEntryPartialText : list ${tableEntryPartialTextList}) {
			AssertTextEquals.assertPartialText(
				key_tableEntry = ${tableEntry},
				key_tableEntryPartialText = ${tableEntryPartialText},
				locator1 = "LexiconTable#TABLE_ENTRY_PARTIAL_TEXT",
				value1 = ${tableEntryPartialText});
		}
	}

}