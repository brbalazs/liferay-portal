definition {

	@summary = "Default summary"
	macro changeDisplayStyle(displayStyle = null) {
		WaitForPageLoad();

		Click(locator1 = "Icon#CURRENT_DISPLAY_STYLE");

		if (IsElementNotPresent(key_menuItem = StringUtil.upperCaseFirstLetter(${displayStyle}), locator1 = "MenuItem#ANY_MENU_ITEM")) {
			Refresh();

			WaitForPageLoad();

			Click.mouseOverClick(locator1 = "Icon#CURRENT_DISPLAY_STYLE");
		}

		MenuItem.click(menuItem = StringUtil.upperCaseFirstLetter(${displayStyle}));
	}

	@summary = "Default summary"
	macro changeExportDisplayStyle(displayStyle = null) {
		Click.clickNoMouseOverNoWaitForVisible(locator1 = "Icon#CURRENT_DISPLAY_STYLE");

		Click.clickNoMouseOverNoWaitForVisible(
			key_menuItem = StringUtil.upperCaseFirstLetter(${displayStyle}),
			locator1 = "MenuItem#ANY_MENU_ITEM");
	}

	@summary = "Default summary"
	macro delete(rowEntry = null, failure = null, confirmationText = null) {
		LexiconEntry.gotoEntryMenuItemNoError(
			menuItem = "Delete",
			rowEntry = ${rowEntry});

		if (isSet(confirmationText)) {
			AssertConfirm(value1 = ${confirmationText});
		}
		else {
			Confirm();
		}

		if (isSet(failure)) {
			if (IsElementPresent(locator1 = "Message#ERROR_2")) {
				Alert.viewRequestFailedToComplete();

				AssertTextEquals(
					locator1 = "Message#ERROR_2",
					value1 = ${failure});
			}
			else {
				AssertTextEquals.assertPartialText(
					locator1 = "Message#ERROR",
					value1 = ${failure});
			}
		}
		else {
			Alert.viewSuccessMessage();
		}
	}

	@summary = "Default summary"
	macro gotoAdd() {
		var browserType = PropsUtil.get("browser.type");

		if (${browserType} == "chrome") {
			LexiconEntry.waitForManagementBar();
		}

		if (${browserType} == "internetexplorer") {
			Click(locator1 = "Button#PLUS_IE");
		}
		else {
			Click(locator1 = "Button#PLUS");
		}
	}

	@summary = "Default summary"
	macro gotoAddDropdownMenuItem(menuItem = null) {
		LexiconEntry.gotoAdd();

		DropdownMenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoAddMenuItem(menuItem = null) {
		LexiconEntry.gotoAdd();

		MenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoEllipsisMenuItem(menuItem = null) {
		Click.waitForMenuToggleJSClick(locator1 = "Icon#BODY_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoEllipsisMenuItemNoError(menuItem = null) {
		Click.waitForMenuToggleJSClick(locator1 = "Icon#BODY_VERTICAL_ELLIPSIS");

		MenuItem.clickNoError(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoEntry(rowEntry = null) {
		if (IsElementPresent(key_displayStyle = "cards", locator1 = "Icon#DISPLAY_STYLE_ACTIVE")) {
			AssertClick(
				key_cardText = ${rowEntry},
				locator1 = "Card#SPECIFIC_LARGE_TEXT",
				value1 = ${rowEntry});
		}
		else {
			AssertClick(
				key_rowEntry = ${rowEntry},
				locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME",
				value1 = ${rowEntry});
		}
	}

	@summary = "Default summary"
	macro gotoEntryMenuItem(rowEntry = null, menuItem = null) {
		LexiconEntry.openEntryMenu(rowEntry = ${rowEntry});

		MenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoEntryMenuItemNoError(rowEntry = null, menuItem = null) {
		LexiconEntry.openEntryMenu(rowEntry = ${rowEntry});

		MenuItem.clickNoError(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoEntryMenuItemNoWait(rowEntry = null, menuItem = null) {
		LexiconEntry.openEntryMenu(rowEntry = ${rowEntry});

		MenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoEntryMenuItemNoWaitNoError(rowEntry = null, menuItem = null) {
		LexiconEntry.openEntryMenu(rowEntry = ${rowEntry});

		MenuItem.clickNoError(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro gotoHeaderMenuItem(menuItem = null) {
		Click(locator1 = "Icon#HEADER_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro openEntryMenu(rowEntry = null) {
		Click.waitForMenuToggleJSClick(
			key_rowEntry = ${rowEntry},
			locator1 = "Icon#ROW_VERTICAL_ELLIPSIS");
	}

	@summary = "Default summary"
	macro selectEntry(rowEntry = null) {
		Check(
			key_rowEntry = ${rowEntry},
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_CHECKBOX");
	}

	@summary = "Default summary"
	macro viewActiveDisplayStyle(displayStyle = null) {
		AssertElementPresent(
			key_displayStyle = ${displayStyle},
			locator1 = "Icon#CURRENT_DISPLAY_STYLE_ACTIVE");
	}

	@summary = "Default summary"
	macro viewEntryName(rowEntry = null) {
		AssertTextEquals(
			key_rowEntry = ${rowEntry},
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME",
			value1 = ${rowEntry});
	}

	@summary = "Default summary"
	macro viewEntryNamePartial(rowEntry = null) {
		AssertTextEquals.assertPartialText(
			key_rowEntry = ${rowEntry},
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME",
			value1 = ${rowEntry});
	}

	@summary = "Default summary"
	macro viewNoEntry(rowEntry = null) {
		AssertElementNotPresent(
			key_rowEntry = ${rowEntry},
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");
	}

	@summary = "Default summary"
	macro viewNoEntryMenu(rowEntry = null) {
		AssertElementNotPresent(
			key_rowEntry = ${rowEntry},
			locator1 = "Icon#ROW_VERTICAL_ELLIPSIS");
	}

	@summary = "Default summary"
	macro viewNoEntryMenuItem(rowEntry = null, menuItem = null) {
		LexiconEntry.openEntryMenu(rowEntry = ${rowEntry});

		AssertElementNotPresent(
			key_menuItem = ${menuItem},
			locator1 = "MenuItem#ANY_MENU_ITEM");
	}

	@summary = "Default summary"
	macro waitForManagementBar() {
		Pause(locator1 = 1000);

		AssertVisible(locator1 = "ManagementBar#MANAGEMENT_BAR");

		var javaScript = '''
var managementBar = Liferay.component(document.querySelector("div.management-bar-container"));

if (managementBar !== undefined) {
	if (managementBar.wasRendered) {
		return 'ready';
	}
	else {
		return 'pending';
	}
}
else {
	return 'pending';
}
		''';
		var managementBarReady = "";

		while (${managementBarReady} != "ready") {
			var managementBarReady = selenium.getEval(${javaScript});

			Pause(locator1 = 1000);
		}
	}

}