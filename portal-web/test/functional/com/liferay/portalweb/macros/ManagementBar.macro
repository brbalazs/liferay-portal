definition {

	@summary = "Default summary"
	macro setFilterAndOrder(orderBy = null, filterBy = null) {
		if (isSet(filterBy)) {
			var menuItem = ${filterBy};
		}
		else if (isSet(orderBy)) {
			var menuItem = ${orderBy};
		}

		Click(locator1 = "ManagementBar#FILTER_AND_ORDER");

		MenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro toggleViewOrder(order = null) {
		if (IsElementNotPresent(key_order = ${order}, locator1 = "ManagementBar#ORDER_ICON_SPECIFIC")) {
			Click(locator1 = "ManagementBar#ORDER_ICON_GENERIC");

			MouseOver(locator1 = "ManagementBar#FILTER_AND_ORDER");
		}

		Refresh();

		AssertElementPresent(
			key_order = ${order},
			locator1 = "ManagementBar#ORDER_ICON_SPECIFIC");
	}

}