definition {

	@summary = "Default summary"
	macro addOrganization(organizationName = null) {
		LexiconEntry.gotoAdd();

		PortletEntry.inputName(name = ${organizationName});

		PortletEntry.save();
	}

	@summary = "Default summary"
	macro changeUserLanguage(saveButton = null, languageName = null) {
		Select(
			locator1 = "MyAccount#LANGUAGE_SELECT",
			value1 = ${languageName});

		var key_saveButton = ${saveButton};

		AssertClick(
			locator1 = "Button#SAVE_LOCALIZED",
			value1 = ${saveButton});

		AssertElementPresent(locator1 = "Message#SUCCESS");
	}

	@summary = "Default summary"
	macro configureDisplaySettingsLanguage(languageName = null) {
		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "My Account",
			panel = "User",
			portlet = "Account Settings");

		Select(
			locator1 = "MyAccount#LANGUAGE_SELECT",
			value1 = ${languageName});

		AssertClick(
			locator1 = "Button#SAVE",
			value1 = "Save");

		AssertElementPresent(locator1 = "Message#SUCCESS");
	}

	@summary = "Default summary"
	macro configureDisplaySettingsLanguageLocalized(portlet = null, category = null, saveButton = null, languageName = null) {
		ProductMenu.gotoPortlet(
			category = ${category},
			panel = "User",
			portlet = ${portlet});

		Select(
			locator1 = "MyAccount#LANGUAGE_SELECT",
			value1 = ${languageName});

		var key_saveButton = ${saveButton};

		AssertClick(
			locator1 = "Button#SAVE_LOCALIZED",
			value1 = ${saveButton});

		AssertElementPresent(locator1 = "Message#SUCCESS");
	}

	@summary = "Default summary"
	macro editPasswordInvalidCP(newPassword = null, changeable = null, currentPassword = null) {
		UserNavigator.gotoPassword();

		if (isSet(currentPassword)) {
			Type(
				locator1 = "TextInput#CURRENT_PASSWORD",
				value1 = ${currentPassword});
		}
		else {
			Type(
				locator1 = "TextInput#CURRENT_PASSWORD",
				value1 = "test");
		}

		Type(
			locator1 = "TextInput#NEW_PASSWORD",
			value1 = ${newPassword});

		Type(
			locator1 = "TextInput#ENTER_AGAIN",
			value1 = ${newPassword});

		Button.clickSave();

		if (${changeable} == "false") {
			Alert.viewRequestFailedToComplete();

			AssertTextEquals.assertPartialText(
				locator1 = "Message#ERROR_1",
				value1 = "Passwords may not be changed under the current password policy.");
		}
		else {
			Alert.viewRequestFailedToComplete();

			AssertTextEquals.assertPartialText(
				locator1 = "Message#ERROR_1",
				value1 = "That password is invalid. Please enter in a different password.");
		}
	}

	@summary = "Default summary"
	macro view() {
		AssertElementPresent(locator1 = "UsersAndOrganizationsEditUser#CATEGORIZATION_LABEL");

		UserNavigator.gotoOrganizations();

		UserNavigator.gotoMemberships();

		UserNavigator.gotoRoles();

		UserNavigator.gotoPassword();
	}

}