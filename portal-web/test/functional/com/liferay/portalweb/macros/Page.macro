	@summary = "Default summary"
	macro viewFriendlyURLLanguageOptionsPG(currentLanguageList = null, assertUnavailableLanguages = null, fieldName = null, unavailableLanguageList = null) {
		Click(
			key_fieldName = ${fieldName},
			locator1 = "Button#LOCALIZATION");

		for (var locale : list ${currentLanguageList}) {
			AssertElementPresent(
				key_locale = ${locale},
				locator1 = "Translation#LOCALIZATION_NAME");
		}

		if (${assertUnavailableLanguages} == "true") {
			for (var locale : list ${unavailableLanguageList}) {
				AssertElementNotPresent(
					key_locale = ${locale},
					locator1 = "Translation#LOCALIZATION_NAME");
			}
		}

		Click(
			key_fieldName = ${fieldName},
			locator1 = "Button#LOCALIZATION");
	}

