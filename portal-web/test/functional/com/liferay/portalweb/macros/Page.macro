	@summary = "Default summary"
	macro tearDownCP() {
		var siteName = TestCase.getSiteName(siteName = ${siteName});

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages");

		while (IsElementPresent(key_index = 3, locator1 = "SitePages#LIST_GROUP_ITEM_ROW_ELLIPSIS")) {
			Click.waitForMenuToggleJSClick(
				key_index = 3,
				locator1 = "SitePages#LIST_GROUP_ITEM_ROW_ELLIPSIS");

			MenuItem.clickNoError(menuItem = "Delete");

			AssertConfirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");
		}

		AssertElementNotPresent(
			key_index = 3,
			locator1 = "SitePages#LIST_GROUP_ITEM_ROW_ELLIPSIS");
	}

	@summary = "Default summary"
	macro tearDownPG() {
		Page.tearDownCP();
	}

	@summary = "Default summary"
	macro togglePageTemplateInheritChanges(toggleValue = null) {
		if (${toggleValue} == "enable") {
			Check.checkToggleSwitch(
				key_toggleSwitchLabel = "Inherit Changes",
				locator1 = "ToggleSwitch#ANY_TOGGLE_SWITCH");
		}
		else if (${toggleValue} == "disable") {
			Uncheck.uncheckToggleSwitch(
				key_toggleSwitchLabel = "Inherit Changes",
				locator1 = "ToggleSwitch#ANY_TOGGLE_SWITCH");
		}
	}

	@summary = "Default summary"
	macro uploadFileForLogo(logoFile = null) {
		AssertClick(
			locator1 = "Button#CHANGE_LOGO",
			value1 = "Change");

		SelectFrame(locator1 = "SitePages#LOGO_UPLOAD_IMAGE_IFRAME");

		AssertElementPresent(locator1 = "SitePages#LOGO_UPLOAD_IMAGE_BUTTON");

		UploadCommonFile.uploadCommonFileHiddenNoMouseOver(
			locator1 = "TextInput#FILE",
			value1 = ${logoFile});

		Pause(value1 = 5000);

		Button.clickDone();

		Pause(value1 = 5000);

		SelectFrameTop();

		PortletEntry.save();
	}

	@summary = "Default summary"
	macro view(depth = null, privacy = null, pageName = null) {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages");

		SitePages.togglePrivacy(privacy = ${privacy});

		if (isSet(depth)) {
			SitePages.expandPageTree(depth = ${depth});
		}

		AssertElementPresent(
			key_itemName = ${pageName},
			locator1 = "SitePages#LIST_GROUP_ITEM");
	}

	@summary = "Default summary"
	macro viewChildPageDropdown(viewChildPageDropdown = null, childPageName = null, javaScriptPage = null) {
