		MouseOver.mouseOverClickNavigation(locator1 = "Home#PAGE_2");

		var key_childPageName = ${childPageName};

		AssertTextEquals(
			locator1 = "Home#PAGE_CHILD_PAGE",
			value1 = ${childPageName});
