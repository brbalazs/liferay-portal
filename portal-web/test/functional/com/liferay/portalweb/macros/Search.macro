definition {

	@summary = "Default summary"
	macro openSearchPage() {
		if (!(isSet(siteURLKey))) {
			var siteURLKey = "guest";
		}

		Navigator.openWithAppendToBaseURL(urlAppend = "web/${siteURLKey}/search");
	}

	@summary = "Default summary"
	macro searchCP(searchTerm = null) {
		AssertElementPresent(locator1 = "TextInput#SEARCH");

		AssertElementPresent(locator1 = "Icon#BASIC_SEARCH");

		Type(
			locator1 = "TextInput#SEARCH",
			value1 = ${searchTerm});

		KeyPress(
			locator1 = "TextInput#SEARCH",
			value1 = "\RETURN");
	}

	@summary = "Default summary"
	macro searchPG(searchTerm = null, portletName = null) {
		var key_portletName = ${portletName};

		AssertElementPresent(locator1 = "Portlet#SEARCH_FIELD");

		Type(
			locator1 = "Portlet#SEARCH_FIELD",
			value1 = ${searchTerm});

		KeyPress(
			locator1 = "Portlet#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@summary = "Default summary"
	macro viewNoResultAssetTitle(searchAssetTitle = null) {
		AssertElementNotPresent(
			key_searchAssetTitle = ${searchAssetTitle},
			locator1 = "SearchResults#ASSET_ENTRY_TABLE_TITLE");
	}

	@summary = "Default summary"
	macro viewResultAssetTitle(searchAssetTitle = null) {
		var key_searchAssetTitle = ${searchAssetTitle};

		AssertTextEquals(
			locator1 = "SearchResults#ASSET_ENTRY_TABLE_TITLE",
			value1 = ${searchAssetTitle});
	}

}