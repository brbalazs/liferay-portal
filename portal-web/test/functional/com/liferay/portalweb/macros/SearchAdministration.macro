definition {

	macro assertEngineVendorAndVersions {
		WaitForSPARefresh();

		var alertInfo = selenium.getText("//div[contains(@class,'alert alert-info')]");
		var searchEngineVendor = RegexUtil.replace("${alertInfo}", "Vendor: (.*?),", "1");
		var searchClientVersion = RegexUtil.replace("${alertInfo}", "Client Version: (.*?),", "1");
		var searchServerVersion = RegexUtil.replace("${alertInfo}", "Nodes:.*\((.*)\)", "1");

		if (!(contains("${searchEngineVendor}", "${engineVendor}"))) {
			fail("Failed to find correct search engine vendor");
		}

		if ("${searchClientVersion}" != "${clientVersion}") {
			fail("Failed to find correct search client version");
		}

		if ("${searchServerVersion}" != "${serverVersion}") {
			fail("Failed to find correct search server version");
		}
	}

	macro executeSearchActions {
		AssertTextEquals(
			locator1 = "Portlet#HEADER",
			value1 = "Search");

		var alertInfo = selenium.getText("//div[contains(@class,'alert alert-info')]");
		var vendor = StringUtil.extractFirst("${alertInfo}", ",");
		var searchEngineVendor = StringUtil.extractLast("${vendor}", "Vendor:");
		var portalHostname = PropsUtil.get("portal.hostname");
		var curl = "http://${portalHostname}:9200/_tasks";

		Panel.expandPanel(panel = "Index Actions");

		AssertClick(
			key_actionsDescription = "${actionsDescription}",
			locator1 = "Button#EXECUTE_ACTION",
			value1 = "Execute");

		var reindexElapsedTime = "0";
		var reindexStartTime = "0";

		if (contains("${searchEngineVendor}", "Elasticsearch")) {
			echo("Current Elasticsearch Tasks:");

			var elasticsearchTasks = JSONCurlUtil.get("${curl}");

			while (!(contains("${elasticsearchTasks}", "indices:data/write/bulk")) && ("${reindexStartTime}" != "10")) {
				Pause.pauseNoSPARefresh(locator1 = "1000");

				var reindexStartTime = ${reindexStartTime} + 1;

				echo("Current Elasticsearch Tasks:");

				var elasticsearchTasks = JSONCurlUtil.get("${curl}");
			}

			if ("${reindexStartTime}" == "10") {
				echo("Elasticsearch failed to receive reindex request after 10 seconds.");
			}
			else {
				echo("Started reindexing ${reindexStartTime} second(s) after clicking 'Execute'.");
			}

			while (contains("${elasticsearchTasks}", "indices:data/write/bulk") && ("${reindexElapsedTime}" != "120")) {
				Pause.pauseNoSPARefresh(locator1 = "5000");

				var reindexElapsedTime = ${reindexElapsedTime} + 5;

				echo("Current Elasticsearch Tasks:");

				var elasticsearchTasks = JSONCurlUtil.get("${curl}");
			}
		}
		else if (contains("${searchEngineVendor}", "Solr")) {
			while ((IsElementPresent(locator1 = "ControlMenu#RELOAD_TOOLTIP")) && ("${reindexElapsedTime}" != "120")) {
				Pause.pauseNoSPARefresh(locator1 = "5000");

				var reindexElapsedTime = ${reindexElapsedTime} + 5;
			}
		}

		while (IsElementNotPresent(key_actionsDescription = "${actionsDescription}", locator1 = "Button#EXECUTE_ACTION")) {
			Pause(locator1 = "3000");
		}

		if ("${reindexElapsedTime}" == "120") {
			fail("Reindex timed out after 120 seconds.");
		}
		else {
			echo("Finished reindexing after ${reindexElapsedTime} seconds.");
		}
	}

	macro getServerVersion {
		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Search");

		WaitForSPARefresh();

		var alertInfo = selenium.getText("//div[contains(@class,'alert alert-info')]");
		var serverVersion = RegexUtil.replace("${alertInfo}", "Nodes:.*\((.*)\)", "1");

		return "${serverVersion}";
	}

	macro viewActiveConnectionsError {
		if (IsTextEqual.isPartialText(locator1 = "Message#ERROR", value1 = "are available")) {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#ERROR",
				value1 = "None of the configured nodes are available");
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#ERROR",
				value1 = "None of the configured nodes were available");
		}
	}

}