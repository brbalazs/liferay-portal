	@summary = "Default summary"
	macro remoteStagingSetUp(pageVersioningEnabled = null, remotePort = null, editActivateStaging = null, siteName = null, uncheckContent = null, contentName = null) {
		if (isSet(remotePort)) {
			User.loginPG(
				nodePort = ${remotePort},
				password = "test",
				userEmailAddress = "test@liferay.com");
		}
		else {
			Navigator.openURL();
		}

		var siteID = ${siteID};

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addBlankCP(siteName = "Remote Site");

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Site Administration",
			portlet = "Site Settings");

		var siteID = selenium.getElementValue("SitesEditSite#SITE_ID");

		if (isSet(remotePort)) {
			User.loginPG(
				nodePort = 8080,
				password = "test",
				userEmailAddress = "test@liferay.com");
		}

		SitePages.openPagesAdmin(siteURLKey = ${siteName});

		ProductMenu.gotoPortlet(
			category = "Publishing",
			panel = "Site Administration",
			portlet = "Staging");

		Staging.activateStagingCP(
			contentName = ${contentName},
			editActivateStaging = ${editActivateStaging},
			pageVersioningEnabled = ${pageVersioningEnabled},
			remotePort = ${remotePort},
			remoteStaging = "true",
			siteID = ${siteID},
			siteName = ${siteName},
			uncheckContent = ${uncheckContent});
	}

