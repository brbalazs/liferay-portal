definition {

	@summary = "Default summary"
	macro _addAnnouncement(userPassword = null, announcementURL = null, displayDate = null, announcementTitle = null, announcementContent = null, userEmailAddress = null, announcementType = null, priority = null, expirationDate = null) {
		Variables.assertDefined(parameterList = "${announcementTitle},${announcementContent}");

		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/announcementsentry/add-entry \
				-u ${userEmailAddress}:${userPassword} \
				-d classNameId=0 \
				-d classPK=0 \
				-d title=${announcementTitle} \
				-d content=${announcementContent} \
				-d url=${announcementURL} \
				-d type=${announcementType} \
				-d displayDate=${displayDate} \
				-d expirationDate=${expirationDate} \
				-d priority=${priority} \
				-d alert=false
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

}