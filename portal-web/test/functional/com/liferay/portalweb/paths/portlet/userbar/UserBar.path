<html>
<head>
<title>UserBar</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">UserBar</td></tr>
</thead>

<tbody>
<tr>
	<td>USER_AVATAR_DROPDOWN_ITEM</td>
	<td>//div[contains(@id,'userCollapse') and contains(@class,'show')]//a[contains(.,'${key_dropdownItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_AVATAR_IMAGE</td>
	<td>//*[@data-qa-id='openUserMenu'] | //span[@class='user-avatar-image']</td>
	<td></td>
</tr>
<tr>
	<td>USER_PROFILE</td>
	<td>//a[contains(.,'Profile')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_DASHBOARD</td>
	<td>//a[contains(.,'Dashboard')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_SIGN_OUT</td>
	<td>//a[contains(.,'Sign Out')] | //a[@href='/c/portal/logout']</td>
	<td></td>
</tr>
<tr>
	<td>USER_SIGN_IN</td>
	<td>//span[contains(@class,'sign-in')]/a/span</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>