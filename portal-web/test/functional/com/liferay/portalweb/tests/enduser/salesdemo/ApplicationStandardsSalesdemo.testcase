@component-name = "portal-application-standards"
@ignore = "true"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Application Standards";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Page.tearDownCP();
		}
	}

	@priority = 4
	test WebProxyDemo {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Web Proxy Page");

		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Guest",
			layoutName = "Web Proxy Page",
			widgetName = "Web Proxy");

		Navigator.gotoPage(pageName = "Web Proxy Page");

		Portlet.gotoPortletOptions(portletOption = "Configuration");

		WebProxy.addCP(initialURL = "http://images.google.com/");

		Navigator.gotoPage(pageName = "Web Proxy Page");

		AssertTextPresent(
			locator1 = "Portlet#H2_HEADER",
			value1 = "Google Images");

		takeScreenshot();

		SikuliAssertElementPresent(locator1 = "WebProxy#SCREENSHOTS_GOOGLE_IMAGES_PNG");
	}

}