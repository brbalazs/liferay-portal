		Form.editFieldLabel(fieldValue = "Date Field");

		Form.closeSidebar();

		FormsAdminNavigator.gotoRules();

		FormRules.addRule();

		FormRules.viewRuleConditionDropdownDisabled();

		FormRules.addCondition();

		FormRules.viewRuleConditionDropdownEnabled();

