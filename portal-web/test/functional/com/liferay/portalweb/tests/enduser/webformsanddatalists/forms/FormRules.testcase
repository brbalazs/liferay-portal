	@priority = "4"
	test ConfigureUserBelongsToRule {
		property test.name.skip.portal.instance = "FormRules#ConfigureUserBelongsToRule";

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Search");

		SearchAdministration.executeSearchActions(actionsDescription = "Reindex all search indexes.");

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Forms");

		FormsAdminNavigator.gotoAddForm();

		Form.editName();

		Form.gotoAddField(fieldType = "Text Field");

		Form.editFieldLabel(fieldValue = "Public");

		Form.closeSidebar();

		Form.gotoAddField(fieldType = "Text Field");

		Form.editFieldLabel(fieldValue = "Manager");

		Form.closeSidebar();

		FormsAdminNavigator.gotoRules();

		FormRules.addRule();

		FormRules.configureConditionOptions(
			conditionField = "User",
			conditionOperator = "Belongs to",
			conditionRowNumber = "1",
			conditionValueType = "Site Administrator");

		FormRules.configureActionOptions(
			action = "Show",
			actionRowNumber = "1",
			actionTarget = "Manager");

		FormRules.addAction();

		FormRules.configureActionOptions(
			action = "Require",
			actionRowNumber = "2",
			actionTarget = "Manager");

		FormRules.save();

		FormRules.viewSummary(
			action = "Require",
			actionTarget = "Manager",
			conditionField = "User",
			conditionFieldConstant = "Site Administrator",
			conditionOperator = "Belongs to",
			ruleNumber = "1");

		FormRules.viewSummary(
			action = "Show",
			actionTarget = "Manager",
			conditionField = "User",
			conditionFieldConstant = "Site Administrator",
			conditionOperator = "Belongs to",
			ruleNumber = "1");

		FormsAdminNavigator.gotoFormBuilder();

		Form.save();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Form Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Form Page",
			widgetName = "Form");

		Navigator.gotoPage(pageName = "Form Page");

		FormPortletNavigator.gotoSelectForm();

		FormPortletConfiguration.selectForm();

		PortletEntry.save();

		Navigator.gotoPage(pageName = "Form Page");

		FormFields.viewTextField(
			fieldLabel = "Public",
			fieldName = "Public");

		FormFields.viewTextFieldNotVisible(
			fieldLabel = "Manager",
			fieldName = "Manager");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		User.assignSiteRoleCP(
			siteRoleName = "Site Administrator",
			userScreenName = "test");

		Navigator.gotoPage(pageName = "Form Page");

		FormFields.viewTextField(
			fieldLabel = "Public",
			fieldName = "Public");

		FormFields.viewTextField(
			fieldLabel = "Manager",
			fieldName = "Manager");

		FormFields.editText(
			fieldName = "Public",
			fieldValue = "Message");

		FormFields.editText(
			fieldName = "Manager",
			fieldValue = "Admin Comments");

		FormFields.viewTextField(
			fieldLabel = "Manager",
			fieldName = "Manager");

		FormPortlet.submitSuccessfully();

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Forms");

		FormsAdminNavigator.gotoViewEntries();

		FormsAdmin.viewFormTableEntry(
			fieldLabel = "Public",
			fieldValue = "Message");

		FormsAdmin.viewFormTableEntry(
			fieldLabel = "Manager",
			fieldValue = "Admin Comments");
	}

	@description = "This is a use case for LPS-79095."
	@priority = "5"
	test EditRule {
		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Forms");

		FormsAdminNavigator.gotoAddForm();

		Form.editName();

		Form.gotoAddField(fieldType = "Text Field");

		Form.editFieldLabel(fieldValue = "Text Field");

		Form.closeSidebar();

		Form.gotoAddField(fieldType = "Text Field");

		Form.editFieldLabel(fieldValue = "Text Field 2");

		Form.closeSidebar();

		FormsAdminNavigator.gotoRules();

		FormRules.addRule();

		FormRules.configureConditionOptions(
			conditionField = "Text Field",
			conditionFieldValue = "test",
			conditionOperator = "Is equal to",
			conditionRowNumber = "1",
			conditionValueType = "Value");

		FormRules.configureActionOptions(
			action = "Require",
