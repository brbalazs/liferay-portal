@component-name = "portal-wcm"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Personalization and Customization,Site Pages Administration";
	property testray.main.component.name = "Site Pages Administration";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			User.logoutAndLoginPG(
				password = "test",
				userLoginEmailAddress = "test@liferay.com",
				userLoginFullName = "Test Test");

			User.tearDownCP();

			Site.tearDownCP();

			Role.tearDownCP();
		}
	}

	@priority = "4"
	test AddPortletAsUserWithCustomizePermission {
		property custom.properties = "jsonws.web.service.paths.excludes=";

		JSONGroup.addGroup(groupName = "Site Name");

		JSONLayout.addPublicLayout(
			groupName = "Site Name",
			layoutName = "Site Page Name");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages");

		PageCustomizations.enableSectionCustomizableCP(
			columnId = "1",
			pageName = "Site Page Name");

		JSONUser.addUser(
			userEmailAddress = "userea@liferay.com",
			userFirstName = "userfn",
			userLastName = "userln",
			userScreenName = "usersn");

		JSONUser.setFirstPassword(
			agreeToTermsAndAnswerReminderQuery = "true",
			requireReset = "false",
			userEmailAddress = "userea@liferay.com");

		JSONRole.addRegularRole(
			roleKey = "Roles Regrole Name",
			roleTitle = "Roles Regrole Name");

		Permissions.definePermissionViaJSONAPI(
			resourceAction = "CUSTOMIZE",
			resourceName = "com.liferay.portal.kernel.model.Layout",
			roleTitle = "Roles Regrole Name");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		User.assignRegularRoleCP(
			roleTitle = "Roles Regrole Name",
			userScreenName = "usersn");

		User.logoutAndLoginPG(
			password = "test",
			userLoginEmailAddress = "userea@liferay.com",
			userLoginFullName = "userfn userln");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		Portlet.addPG(portletName = "Navigation Menu");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		Portlet.viewSpecificPG(portletName = "Navigation Menu");
	}

	@description = "This is a test for LPS-75936. Full Page Application page types allow users to access portlets and make changes without the required permissions."
	@priority = "5"
	test CanAccessProductMenuPermissionsAfterUsingFullPageApplication {
		var portalURL = PropsUtil.get("portal.url");

		task ("Given as admin user create a new page 'SPA' with type Full Page Application") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Test Page Name",
				type = "full_page_application");
		}

		task ("And delete the welcome page") {
			SitePages.openPagesAdmin(siteURLKey = "guest");

			SitePages.deletePage(pageName = "Welcome");
		}

		task ("When going to the page created before and closing the menu on the left") {
			Navigator.openWithAppendToBaseURL(urlAppend = "test-page-name");

			ProductMenuHelper.closeProductMenu();
		}

		task ("And sign out by sending http://localhost:8080/c/portal/logout, and log in again as admin") {
			Navigator.openSpecificURL(url = "${portalURL}/c/portal/logout");

			User._login(
				password = "test",
				userEmailAddress = "test@liferay.com");
		}

		task ("Then the menu is visible after opening the product menu, and no error message "You do not have the roles required to access this portlet."") {
			ProductMenuHelper.openProductMenu();

			AssertElementNotPresent(
				locator1 = "Portlet#ERROR",
				value1 = "You do not have the roles required to access this portlet.");
		}
	}

	@priority = "4"
	test PortletConfigurationChangesWithinCustomizableColumnShouldNotAffectAllUsers {
		property custom.properties = "jsonws.web.service.paths.excludes=";

		JSONGroup.addGroup(groupName = "Site Name");

		JSONLayout.addPublicLayout(
			groupName = "Site Name",
			layoutName = "Site Page Name");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages");

		PageCustomizations.enableSectionCustomizableCP(
			columnId = "1",
			pageName = "Site Page Name");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		PageCustomizations.viewCustomizablePagePG();

		AssertClick(
			locator1 = "Home#PAGE_CUSTOMIZATION_VIEW_DEFAULT_PAGE",
			value1 = "View Page without my customizations");

		Portlet.addPG(portletName = "Wiki");

		Portlet.viewSpecificPG(portletName = "Wiki");

		JSONUser.addUser(
			userEmailAddress = "userea@liferay.com",
			userFirstName = "userfn",
			userLastName = "userln",
			userScreenName = "usersn");

		JSONUser.setFirstPassword(
			agreeToTermsAndAnswerReminderQuery = "true",
			requireReset = "false",
			userEmailAddress = "userea@liferay.com");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		User.editUserSiteCP(
			siteName = "Site Name",
			userScreenName = "usersn");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "userea@liferay.com");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		Portlet.gotoPortletOptions(
			portletName = "Wiki",
			portletOption = "Configuration");

		WikiPortlet.configureSharingAllowUsersToAddWikiToAnyWebsite(enabled = "true");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "test@liferay.com");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		Portlet.gotoPortletOptions(
			portletName = "Wiki",
			portletOption = "Configuration");

		WikiPortlet.viewConfigureSharingAllowUsersToAddWikiToAnyWebsite(enabled = "false");
	}

	@priority = "4"
	test SiteMembershouldAddAndRemovePortletFromHisCustomizableView {
		property custom.properties = "jsonws.web.service.paths.excludes=";

		JSONGroup.addGroup(groupName = "Site Name");

		JSONLayout.addPublicLayout(
			groupName = "Site Name",
			layoutName = "Site Page Name");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages");

		PageCustomizations.enableSectionCustomizableCP(
			columnId = "1",
			pageName = "Site Page Name");

		JSONUser.addUser(
			userEmailAddress = "userea@liferay.com",
			userFirstName = "userfn",
			userLastName = "userln",
			userScreenName = "usersn");

		JSONUser.setFirstPassword(
			agreeToTermsAndAnswerReminderQuery = "true",
			requireReset = "false",
			userEmailAddress = "userea@liferay.com");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		User.editUserSiteCP(
			siteName = "Site Name",
			userScreenName = "usersn");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		PageCustomizations.gotoCustomizedPageInfo(viewDefaultPage = "true");

		Portlet.addPG(portletName = "Asset Publisher");

		Refresh();

		Portlet.addPG(portletName = "Language Selector");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "userea@liferay.com");

		Navigator.gotoSitePage(
			pageName = "Site Page Name",
			siteName = "Site Name");

		Portlet.addPG(portletName = "Web Content Display");

		Refresh();

		Portlet.viewSpecificPG(portletName = "Web Content Display");

		Portlet.deletePG(portletName = "Language Selector");

		Portlet.viewNoSpecificPG(portletName = "Language Selector");

		Portlet.addPG(portletName = "Language Selector");

		Refresh();

		Portlet.viewSpecificPG(portletName = "Language Selector");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "test@liferay.com");
	}

	@priority = "4"
	test SiteMemberWithCustomizablePagePermissionsWillOnlySeePortletsInCustomizableView {
		property custom.properties = "jsonws.web.service.paths.excludes=";
		property test.name.skip.portal.instance = "PageCustomizations#SiteMemberWithCustomizablePagePermissionsWillOnlySeePortletsInCustomizableView";

		var siteName = TestCase.getSiteName(siteName = "${siteName}");

		JSONUser.addUser(
			userEmailAddress = "userea@liferay.com",
			userFirstName = "userfn",
			userLastName = "userln",
			userScreenName = "usersn");

		JSONUser.setFirstPassword(
			agreeToTermsAndAnswerReminderQuery = "true",
			requireReset = "false",
			userEmailAddress = "userea@liferay.com");

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Server Administration");

		ServerAdministration.executeServerResourcesActions(actionsDescription = "Clean up permissions");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles");

		RoleNavigator.gotoRoleType(roleType = "Regular");

		Role.add(roleTitle = "Roles Regrole Name");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles");

		Role.definePermissionCP(
			permissionDefinitionKey = "SITE_ADMIN_PAGES_SITE_PAGES_RESOURCE_PERMISSIONS_PAGE_CUSTOMIZE_CHECKBOX",
			permissionDefinitionValue = "Customize",
			roleTitle = "Roles Regrole Name");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		User.assignRegularRoleCP(
			roleTitle = "Roles Regrole Name",
			userScreenName = "usersn");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		Site.assignUserSitesCP(
			siteName = "${siteName}",
			userScreenName = "usersn");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages");

		SitePages.addPublicPage(pageName = "Site Page Name");

		PageCustomizations.enableSectionCustomizableCP(
			columnId = "1",
			pageName = "Site Page Name");

		Navigator.gotoPage(pageName = "Site Page Name");

		PageCustomizations.gotoCustomizedPageInfo(viewDefaultPage = "true");

		Portlet.addPG(portletName = "Message Boards");

		Refresh();

		Portlet.addPG(portletName = "Language Selector");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "userea@liferay.com");

		Navigator.gotoPage(pageName = "Site Page Name");

		PageCustomizations.gotoCustomizedPageInfo(viewDefaultPage = "true");

		Portlet.viewSpecificPG(portletName = "Language Selector");

		Portlet.viewSpecificPG(portletName = "Message Boards");

		LexiconEntry.gotoHeaderMenuItem(menuItem = "View My Customized Page");

		PageCustomizations.gotoCustomizedPageInfo();

		Portlet.viewNoSpecificPG(portletName = "Language Selector");

		Portlet.viewNoSpecificPG(portletName = "Message Boards");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "test@liferay.com");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles");

		Role.definePermissionCP(
			permissionDefinitionKey = "SITE_ADMIN_APPLICATIONS_MESSAGE_BOARDS_APPLICATION_PERMISSIONS_ADD_TO_PAGE_CHECKBOX",
			permissionDefinitionValue = "Add to Page",
			roleTitle = "Roles Regrole Name");

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles");

		Role.definePermissionCP(
			permissionDefinitionKey = "SITE_ADMIN_APPLICATIONS_LANGUAGE_APPLICATION_PERMISSIONS_ADD_TO_PAGE_CHECKBOX",
			permissionDefinitionValue = "Add to Page",
			roleTitle = "Roles Regrole Name");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "userea@liferay.com");

		Navigator.gotoPage(pageName = "Site Page Name");

		PageCustomizations.gotoCustomizedPageInfo(viewDefaultPage = "true");

		Portlet.viewSpecificPG(portletName = "Language Selector");

		Portlet.viewSpecificPG(portletName = "Message Boards");

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "test@liferay.com");
	}

}